<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\NServiceBus.snk</AssemblyOriginatorKeyFile>
    <Description>An Aspire hosting integration for the Particular Service Platform (ServiceControl, ServicePulse).</Description>
    <PackageTags>aspire hosting integration particular nservicebus servicecontrol servicepulse</PackageTags>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <ItemGroup Label="Public dependencies">
    <PackageReference Include="Aspire.Hosting" Version="13.4.3" />
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup Label="Private dependencies">
    <PackageReference Include="Particular.Packaging" Version="4.5.0" PrivateAssets="All" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="Particular.Aspire.Hosting.ServicePlatform.UnitTests" Key="$(NServiceBusTestsKey)" />
  </ItemGroup>

</Project>
